      <aliases enabled='yes' />
      <column caption='Validasi Publisher' datatype='string' name='[Calculation_122160203516850177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Publisher] = &quot;N/A&quot; THEN &quot;Kosong&quot; ELSE &quot;Lengkap&quot; END' />
      </column>
      <column caption='Genre_Popularity' datatype='string' name='[Calculation_122160203540418572]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Global_Sales]) &gt;= 5 THEN &quot;Sangat Populer&quot;&#13;&#10;ELSEIF SUM([Global_Sales]) &gt;= 1 THEN &quot;Populer&quot;&#13;&#10;ELSE &quot;Kurang Populer&quot; END' />
      </column>
      <column caption='Year_Cleaned' datatype='string' datatype-customized='true' name='[Calculation_911416038422757377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Year]) THEN &quot;Tahun Tidak Diketahui&quot; ELSE STR([Year]) END' />
      </column>
      <column caption='Selected Regional Sales' datatype='real' name='[Calculation_911416038566821893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Pivot Field Names] = &quot;NA Sales&quot; THEN [Pivot Field Values]&#13;&#10;ELSEIF [Pivot Field Names] = &quot;EU Sales&quot; THEN [Pivot Field Values]&#13;&#10;ELSEIF [Pivot Field Names] = &quot;JP Sales&quot; THEN [Pivot Field Values]&#13;&#10;ELSEIF [Pivot Field Names] = &quot;Other Sales&quot; THEN [Pivot Field Values]&#13;&#10;END' />
      </column>
      <column caption='Sales Threshold Filter' datatype='boolean' name='[Calculation_911416038571806726]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Global_Sales] &gt; [Parameters].[Parameter 2]' />
      </column>
      <column caption='Kategori Rating' datatype='string' name='[Calculation_911416038595051529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Rating] = &quot;E&quot; OR [Rating] = &quot;EC&quot; OR [Rating] = &quot;E10+&quot; THEN &quot;All Ages&quot;&#13;&#10;ELSEIF [Rating] = &quot;T&quot; THEN &quot;Teen&quot;&#13;&#10;ELSEIF [Rating] = &quot;M&quot; OR [Rating] = &quot;AO&quot; THEN &quot;Mature&quot;&#13;&#10;ELSE &quot;Unrated&quot;&#13;&#10;END' />
      </column>
      <column caption='Q1' datatype='real' name='[Calculation_911416038889259018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_PERCENTILE(SUM([Global_Sales]), 0.25)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Q3' datatype='real' name='[Calculation_911416038889791499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_PERCENTILE(SUM([Global_Sales]), 0.75)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='IQR Outlier Flag' datatype='string' name='[Calculation_911416038889906188]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Rank]) &gt; &#13;&#10;   WINDOW_PERCENTILE(SUM([Rank]), 0.75) + &#13;&#10;   1.5 * (WINDOW_PERCENTILE(SUM([Rank]), 0.75) - WINDOW_PERCENTILE(SUM([Rank]), 0.25))&#13;&#10;THEN &quot;Outlier&quot;&#13;&#10;ELSE &quot;Normal&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Median Global Sales' datatype='real' name='[Calculation_911416038893572109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MEDIAN(SUM([Global_Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
